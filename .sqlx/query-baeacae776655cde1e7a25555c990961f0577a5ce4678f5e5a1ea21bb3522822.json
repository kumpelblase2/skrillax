{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, charname, character_type, scale, level, exp, sp,\n               strength, intelligence, stat_points, current_hp, current_mp,\n               region, deletion_end, last_logout\n        FROM characters\n        WHERE user_id = $1\n          AND server_id = $2\n          AND (deletion_end > NOW() OR deletion_end IS NULL)\n        ORDER BY id\n        ",
